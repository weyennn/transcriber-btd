# Salin ke .env lalu sesuaikan. Docker Compose membaca .env otomatis.
# Jangan commit .env: bisa berisi rahasia.

# Port dashboard di host.
TRANSCRIBE_HOST_PORT=8765

# GPU NVIDIA (sama seperti Doclingo: gpus: all). Untuk diagnosis tanpa GPU:
# TRANSCRIBE_DEVICE=cpu dan TRANSCRIBE_COMPUTE_TYPE=int8.
TRANSCRIBE_DEVICE=cuda
TRANSCRIBE_COMPUTE_TYPE=float16

# UID/GID pemilik folder data/ di host.
TRANSCRIBE_UID=1000
TRANSCRIBE_GID=1000

MAX_UPLOAD_BYTES=2147483648

# Antrean transkripsi: berapa yang jalan bersamaan (1-4), berapa yang boleh menunggu,
# dan batas job (berjalan + menunggu) per pengguna. Dua proses paralel memakai satu model
# di GPU; RAM container naik sekitar 1 GB per proses tambahan.
MAX_CONCURRENT_TRANSCRIBE=2
MAX_TRANSCRIBE_QUEUE=20
MAX_TRANSCRIBE_PER_USER=2

# Hasil (transkrip dan dokumen) dihapus otomatis setelah sekian hari. 0 = tidak dihapus.
RESULT_RETENTION_DAYS=30
APP_BASE_PATH=/transcribe

AI_ENABLED=false
TRANSCRIBE_AI_BASE_URL=
TRANSCRIBE_AI_MODEL=
TRANSCRIBE_AI_API_KEY=

# Login Google (opsional). Kosongkan client ID/secret/session secret untuk menonaktifkan.
AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
AUTH_ALLOWED_DOMAIN=ugm.ac.id
AUTH_COOKIE_SECURE=true
